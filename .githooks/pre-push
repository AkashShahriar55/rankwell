#!/bin/sh
# Runs the same checks as CI before a push leaves your machine. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: ruff, mypy, pytest"
uv run --quiet ruff check
uv run --quiet mypy
uv run --quiet pytest -q -p no:cacheprovider
